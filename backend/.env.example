# Environment
ENV=development
PORT=8000
HOST=0.0.0.0

# ---- Language model provider -------------------------------------------
# Primary: first-party Meta Model API (muse-spark-1.3 text/chat +
# muse-voice-transcribe ASR) at api.meta.ai. Auth via MODEL_API_KEY
# (canonical) or META_API_KEY (alias). Get a key at
# https://dev.meta.ai → Model API → API keys.
LLM_PROVIDER=meta
MODEL_API_KEY=your_model_api_key_here
# META_API_KEY=alias_accepted_for_existing_setups
META_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
META_TEXT_FALLBACK_MODELS=muse-spark-1.2,muse-spark-1.1
META_ASR_MODEL=muse-voice-transcribe-1.0
META_VISION_MODEL=muse-spark-1.3
META_SEGMENT_MODEL=sam-3.1
META_IMAGE_MODEL=muse-image-1.0  # optional B-roll stills, same Model API key
META_ASR_MAX_SECONDS=570  # request cap safety margin (600s limit)

# ---- Failover chain (all slots serve Meta Muse models; Llama is banned) ---
# When the primary provider errors, the call is retried through these slots
# in order; each slot needs its OWN key; slots without credentials are skipped
# at runtime. ENABLE_LLM_FAILOVER=false disables the chain entirely.
#   OpenRouter: meta/muse-spark-open via https://openrouter.ai/api/v1
#     Get a key at https://openrouter.ai/keys (free tier: 50 req/day,
#     1,000 req/day with $10 credits; no card required).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=meta/muse-spark-open
# Order of failover hops after the primary (openrouter, baseten, local).
# ENABLE_LLM_FAILOVER=false disables the chain entirely.
LLM_FALLBACK_PROVIDERS=openrouter
ENABLE_LLM_FAILOVER=true

# Local OpenAI-compatible endpoint (LM Studio / Ollama / vLLM serving a Meta
# open-weight model such as Muse Glimmer; Apache 2.0, no API key needed).
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=meta-models/Muse-Glimmer-30B
LOCAL_LLM_API_KEY=

# Text-to-speech: Meta MMS-TTS open weights only (local, no API key).
TTS_PROVIDER=mms
MMS_TTS_MODEL=facebook/mms-tts-eng
MMS_TTS_LANG=eng

# ---- Persistence --------------------------------------------------------
# Set FIRESTORE_PROJECT_ID to persist state in Firestore; without it the app
# falls back to a local JSON store automatically.
# FIRESTORE_PROJECT_ID=your_project_id
# FIRESTORE_DATABASE=(default)
# FIRESTORE_EMULATOR_HOST=
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/service_account.json
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}  # inline JSON (Render/Actions secret)
# CHRONOCUT_DISABLE_FIRESTORE=1      # force the local JSON store (e.g. after daily quota is gone)
# CHRONOCUT_RESUME_STALE_JOBS=0      # skip the startup re-queue sweep for stale jobs
# CHRONOCUT_MEMORY_CLAMP_MB=700      # free-RAM threshold below which renders downsize

# ---- Stock media providers ----------------------------------------------
# PEXELS_API_KEY=your_pexels_api_key
# PIXABAY_API_KEY=your_pixabay_api_key
# NASA_API_KEY=your_nasa_api_key

# ---- Rendering -----------------------------------------------------------
MAX_RENDER_RESOLUTION=720
DEFAULT_OUTPUT_PROFILES=youtube_landscape
# TEXT_OVERLAY_ENGINE=drawtext
# HYPERFRAMES_BIN=npx hyperframes
# ENABLE_CAPTIONS=false
# ENABLE_MOVIEPY_FALLBACK=false

# ---- Render dispatch ----------------------------------------------------
# local | actions | modal
RENDER_DISPATCHER=local
# CHRONOCUT_DISABLE_RUNNER=false
# MAX_ACTIVE_JOBS=3

# ---- Render output storage ---------------------------------------------
# local | supabase | github_release
STORAGE_BACKEND=local
# SUPABASE_URL=your_supabase_url
# SUPABASE_SERVICE_KEY=your_supabase_service_key
# GH_RELEASE_TAG_PREFIX=chronocut-render

# ---- Render worker (GitHub Actions dispatcher) --------------------------
# GH_REPO=owner/repo
# GH_DISPATCH_TOKEN=your_github_pat

# ---- Modal render app ---------------------------------------------------
# MODAL_ENABLED=false

# ---- Governance / limits -------------------------------------------------
PER_JOB_COST_CAP_CENTS=50
PEXELS_MAX_REQUESTS_PER_HOUR=180
DATA_RETENTION_HOURS=24
CORPUS_RETENTION_HOURS=168

# ---- API-only backend ----------------------------------------------------
# The API never serves the frontend itself; CORS is restricted to the known
# frontend origins. ENVIRONMENT=production enables the self-ping keep-warm
# loop (also gated by the public APP_BASE_URL; disable with KEEP_WARM=off).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# ENVIRONMENT=production
# APP_BASE_URL=https://your-backend-host
# KEEP_WARM=on

# ---- Generated B-roll stills (optional, default off) -----------------------
# First-party Meta Image (muse-image-1.0) via the same Model API key; flat
# $0.01 per image paid from the provisioned free credits. The daily image
# counter caps accidental credit spend.
# IMAGE_GEN_PROVIDER=off|muse
# IMAGE_GEN_DAILY_IMAGES=60
