# Frontend (Vite) env — copy to frontend/.env and adjust.
# The browser talks to the API origin directly; the API serves no frontend.
VITE_API_BASE_URL=http://localhost:8000

# Set to false to ship the timeline workspace without the agent telemetry
# panel (the timeline remains fully usable without it).
# VITE_AGENT_ENABLED=true

# M9 demo resilience: a pre-rendered job id surfaced by the "Load demo
# project" button when no live job is active. Leave unset to hide the button.
# VITE_DEMO_JOB_ID=
